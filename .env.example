NEXT_PUBLIC_API_BASE_URL=/backend
BACKEND_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Workforce Control
# Public URL of the SPX Task Tracker (Vercel production URL or local :3001)
NEXT_PUBLIC_TASK_TRACKER_URL=http://localhost:3001
# Employee app handoff after invite profile completion
NEXT_PUBLIC_EMPLOYEE_WEB_URL=http://localhost:8080
# NEXT_PUBLIC_EMPLOYEE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# NEXT_PUBLIC_EMPLOYEE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=workforce.app
# NEXT_PUBLIC_EMPLOYEE_APP_SCHEME=workforce
# NEXT_PUBLIC_EMPLOYEE_ANDROID_PACKAGE=workforce.app
NODE_ENV=development
# Set to true when the admin portal is served over HTTPS (required for refresh cookie in prod).
# SESSION_COOKIE_SECURE=true

# Office map picker uses free OpenStreetMap tiles + Nominatim geocoding via /api/geo/* (no keys required).
# Nominatim is rate-limited; suitable for low-volume admin use only.
